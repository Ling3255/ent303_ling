# 复制为 .env 后填写。不要把 .env 提交到 GitHub。

# 大模型（OpenAI 兼容接口）。不填则使用规则模式，流程能跑通但只能核对含数字的论断。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 换成通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Crossref / OpenAlex / Unpaywall 要求留联系邮箱
CONTACT_EMAIL=citecheck@example.com

# lexical（默认，BM25）或 bge-m3（需 WITH_EMBED=1 构建）
EMBEDDING_BACKEND=lexical

POSTGRES_PASSWORD=citecheck
UPLOAD_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:5173

# 本地开发时（不用 Docker）可以指向本机的 GROBID：
# GROBID_URL=http://localhost:8070
