# 复制为 .env 后填写。不要把 .env 提交到 GitHub。

# 大模型（OpenAI 兼容接口）。不填则使用规则模式，流程能跑通但只能核对含数字的论断。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 换成通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Crossref / OpenAlex / Unpaywall 要求留联系邮箱
CONTACT_EMAIL=citecheck@example.com

# lexical（默认，BM25）或 bge-m3（需 WITH_EMBED=1 构建）
EMBEDDING_BACKEND=lexical

POSTGRES_PASSWORD=citecheck
UPLOAD_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:5173

# 本地开发时（不用 Docker）可以指向本机的 GROBID：
# GROBID_URL=http://localhost:8070

# 学生账号：AUTH_REQUIRED=1 时必须用学校邮箱登录才能检查，免费版每月 MONTHLY_QUOTA 次
AUTH_REQUIRED=0
ALLOWED_EMAIL_DOMAINS=xjtlu.edu.cn,student.xjtlu.edu.cn
MONTHLY_QUOTA=20
# 验证码邮件（例如阿里云邮件推送 / 学校 SMTP）。不配置时验证码直接显示在登录框里（仅限开发测试）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 正式上线务必设为 0，否则任何人都能看到验证码
DEV_SHOW_CODE=1
